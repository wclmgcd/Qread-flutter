<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qread.qread">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
   <application
        android:label="Qread"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- 【必须开启明文 HTTP】Android 9(P) 起默认 usesCleartextTraffic=false，
             会拦截所有 http:// 请求。而书源给的段评接口、正文图片、发现页地址
             大量是明文 http（例如段评 http://219.154.201.122:5006/get_para_review），
             关着就会报 net::ERR_CLEARTEXT_NOT_PERMITTED、网页无法打开。
             打开后 WebView / 图片 / 接口的 http 都能正常走。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ================= 打开方式（Open with）=================
                 没有这一段，系统「打开方式」里根本不会出现 Qread ——
                 用户从文件管理器 / 聊天软件里点「用其他应用打开」一个
                 .json 书源文件、或者一本 epub / mobi 电子书时，
                 列表里都找不到 Qread。

                 【为什么拆成两个 intent-filter】
                 第 1 个靠 **MIME 类型**匹配：Gmail、Chrome、系统下载器这类
                 知道媒体类型的来源，会带上 `application/json`。
                 第 2 个靠 **文件后缀**匹配：不少文件管理器（尤其国产 ROM 的
                 「文件管理」）只给 `content://` URI + `*/*`，不带 json 类型，
                 这时只能靠 pathPattern 兜住。

                 【为什么第 2 个必须写 android:host="*"】
                 Android 的匹配规则里，`pathPattern` / `pathPrefix` 这些
                 **只有在同时声明了 host 时才会被考虑**。只写 scheme + path
                 是匹配不上的（这是官方文档里的一句话，很容易漏）。

                 【pathAdvancedPattern 是给谁用的】
                 它要求 API 31+，支持 `[jJ]` 这种字符组写法，
                 一次就能覆盖 .json/.JSON/.Json；旧系统上这个属性会被忽略，
                 所以下面同时保留了 `pathPattern` 的大小写两份。
                 写法与 legado 官方 `FileAssociationActivity` 完全一致。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <!-- 电子书。epub / mobi 都有标准 MIME，文件管理器认得出来；
                     octet-stream 是给 .azw3 / .prc 兜底的 —— 国产 ROM 的文件管理器
                     对这两种常见的就是报这个，不给就会出现「点了文件列表里没有 Qread」。 -->
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:host="*" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <!-- 必须有 */*，否则只看后缀是匹配不上的 -->
                <data android:mimeType="*/*" />

                <data android:pathAdvancedPattern=".*\\.[jJ][sS][oO][nN]" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.JSON" />
                <data android:pathAdvancedPattern=".*\\.[tT][xX][tT]" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathAdvancedPattern=".*\\.[eE][pP][uU][bB]" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathAdvancedPattern=".*\\.[mM][oO][bB][iI]" />
                <data android:pathPattern=".*\\.mobi" />
                <data android:pathAdvancedPattern=".*\\.[aA][zZ][wW]3?" />
                <data android:pathPattern=".*\\.azw" />
                <data android:pathPattern=".*\\.azw3" />
                <data android:pathAdvancedPattern=".*\\.[pP][rR][cC]" />
                <data android:pathPattern=".*\\.prc" />
            </intent-filter>
            <!-- ================= 分享（Send）=================
                 从文件管理器「分享」一个 json 给 Qread，
                 以及从浏览器/微信「分享文本」把书源 JSON 直接甩过来。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
            </intent-filter>
        </activity>
        <!-- 【修复】关闭 Impeller，回退到 Skia。
             Android 上 Flutter 默认用 Impeller（Vulkan 后端）。部分 GPU 驱动上
             字形图集/纹理采样精度出问题，整屏文字会碎裂、错位、重叠，锁屏再
             解锁（重建 surface）后又能恢复，正是用户反馈的「字体重叠模糊」。
             关掉后走 Skia，文字渲染稳定。

             【为什么必须写成 meta-data】
             flutter 命令行里的 no-enable-impeller 参数，在 release 构建中会被
             flutter_tools 忽略（会打印 "the flag is ignored in release builds"），
             所以只能写在 manifest 里。引擎侧对应 FlutterEngineFlags.ENABLE_IMPELLER，
             其 metadataKey 前缀固定为 io.flutter.embedding.android.，
             且 allowedInRelease 为 true，因此 release 包同样生效。

             【怎么确认生效】
             adb logcat 过滤关键字 Impeller
             关掉后：不应再出现 "Using the Impeller rendering backend (Vulkan)"
             若仍出现，先 flutter clean 再重新打包（manifest 会被 Gradle 缓存）。

             【如果不想完全放弃 Impeller】
             可以只把后端从 Vulkan 换成 OpenGLES（同样是 release 可用），
             即再加一条 name 为 io.flutter.embedding.android.ImpellerBackend、
             value 为 opengles 的 meta-data。
             下面的 EnableImpeller=false 优先级更高，二选一即可。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
